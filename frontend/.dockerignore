# ================================================
# .dockerignore — Frontend
# ================================================
# Files listed here are EXCLUDED from the Docker build context.
# ================================================

# --- Node modules (npm ci installs fresh inside container) ---
node_modules/

# --- Build output (gets rebuilt inside container) ---
build/
dist/

# --- Git & IDE ---
.git/
.gitignore
.DS_Store
.cursor/
.vscode/

# --- Environment files ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# --- Docs ---
*.md
README*

# --- Misc ---
*.log
*.tmp
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Test files ---
*.test.js
*.spec.js
src/setupTests.js
src/reportWebVitals.js
