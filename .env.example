# ================================================
# Root-level .env.example — COMMIT THIS TO GIT
# ================================================
# Copy to .env and fill in real values.
# .env itself must NOT be committed.
# ================================================

# ---- PostgreSQL Database ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=inventory_db

# ---- Flask Backend ----
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=your-random-secret-key-here
JWT_SECRET=your-random-jwt-secret-here

# DATABASE_URL — use "db" (Docker service name) as the host
DATABASE_URL=postgresql://postgres:your_strong_password_here@db:5432/inventory_db
TEST_DATABASE_URL=postgresql://postgres:your_strong_password_here@db:5432/inventory_db_test

# ---- React Frontend ----
REACT_APP_API_BASE_URL=http://localhost/api/v1

# ---- Port Mappings ----
FRONTEND_PORT=80
BACKEND_PORT=5000
DB_PORT=5432
